# Release signing configuration TEMPLATE.
#
# 1. Copy this file to `android/key.properties` (which is git-ignored).
# 2. Generate an upload keystore:
#      keytool -genkey -v -keystore ~/upload-keystore.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 3. Fill in the real values below.
# 4. Wire the release signingConfig in android/app/build.gradle to read these
#    properties (see RELEASE_CHECKLIST.md, "Android release signing").
#
# NEVER commit android/key.properties or the .jks keystore.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
