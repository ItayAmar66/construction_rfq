rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        request.auth.token.platformAdmin == true;
    }

    function membershipDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(uid()));
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(uid())) &&
        membershipDoc(orgId).data.status == 'active';
    }

    function hasOrgRole(orgId, role) {
      return isOrgMember(orgId) && role in membershipDoc(orgId).data.roles;
    }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId));
    }

    function orgTypeValue(orgId) {
      return orgDoc(orgId).data.type;
    }

    function isContractorOrg(orgId) {
      return orgTypeValue(orgId) == 'contractor';
    }

    function isSupplierOrg(orgId) {
      return orgTypeValue(orgId) == 'supplier';
    }

    // Canonical + legacy role membership checks (legacy values readable during
    // transition; writes accept canonical values only — see contractorOrgRoles).
    function isContractorOwnerMember(orgId) {
      return hasOrgRole(orgId, 'contractorOwner') ||
        hasOrgRole(orgId, 'contractorCompanyOwner');
    }

    function isContractorAdminMember(orgId) {
      return isContractorOwnerMember(orgId) ||
        hasOrgRole(orgId, 'contractorAdmin');
    }

    function isSupplierOwner(orgId) {
      return hasOrgRole(orgId, 'supplierOwner');
    }

    function isSupplierAdminMember(orgId) {
      return isSupplierOwner(orgId) || hasOrgRole(orgId, 'supplierAdmin');
    }

    function isSupplierSalesMember(orgId) {
      return hasOrgRole(orgId, 'supplierSales') ||
        hasOrgRole(orgId, 'supplierSalesManager') ||
        hasOrgRole(orgId, 'supplierSalesRep');
    }

    function isSupplierOperationsMember(orgId) {
      return hasOrgRole(orgId, 'supplierOperations') ||
        hasOrgRole(orgId, 'supplierOps');
    }

    // Membership-level permission exceptions (Permission.value strings).
    function membershipHasGrant(orgId, perm) {
      return isOrgMember(orgId) &&
        perm in membershipDoc(orgId).data.get('grants', []);
    }

    function membershipLacksRevoke(orgId, perm) {
      return !(perm in membershipDoc(orgId).data.get('revokes', []));
    }

    // Contractor project-access mode: explicit orgWideProjectAccess wins,
    // otherwise the role default (owner/admin/procurement see everything).
    function membershipHasOrgWideAccess(orgId) {
      return isOrgMember(orgId) && (
        membershipDoc(orgId).data.keys().hasAny(['orgWideProjectAccess'])
          ? membershipDoc(orgId).data.orgWideProjectAccess == true
          : (
            'contractorOwner' in membershipDoc(orgId).data.roles ||
            'contractorAdmin' in membershipDoc(orgId).data.roles ||
            'contractorCompanyOwner' in membershipDoc(orgId).data.roles ||
            'procurementManager' in membershipDoc(orgId).data.roles
          )
      );
    }

    function canManageOrgMemberships(orgId) {
      return isPlatformAdmin() ||
        (
          (
            (isContractorOrg(orgId) && isContractorAdminMember(orgId)) ||
            (isSupplierOrg(orgId) && isSupplierAdminMember(orgId))
          ) &&
          membershipLacksRevoke(orgId, 'manageUsers')
        );
    }

    function canInviteOrgMembers(orgId) {
      return isPlatformAdmin() || (
        (canManageOrgMemberships(orgId) ||
          (isContractorOrg(orgId) && hasOrgRole(orgId, 'procurementManager'))) &&
        membershipLacksRevoke(orgId, 'inviteUsers')
      );
    }

    // Handing out Owner requires being an Owner (or platform admin) —
    // mirrors lib/utils/role_invitation_policy.dart, where contractorAdmin/
    // supplierAdmin can manage a team but never grant ownership.
    function invitationRoleAllowedForActor(orgId, role) {
      return (
        role != 'contractorOwner' &&
        role != 'supplierOwner' &&
        canManageOrgMemberships(orgId)
      ) ||
        (hasOrgRole(orgId, 'procurementManager') &&
          role in ['engineer', 'contractorViewer']) ||
        (
          (role == 'contractorOwner' || role == 'supplierOwner') &&
          (
            isPlatformAdmin() ||
            isContractorOwnerMember(orgId) ||
            isSupplierOwner(orgId)
          )
        );
    }

    // Arbitrary-uid variant of hasOrgRole, needed to re-check the original
    // inviter's authority at accept time (the caller at accept time is the
    // invitee, not the inviter).
    function membershipDocForUid(orgId, checkUid) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(checkUid));
    }

    function hasOrgRoleForUid(orgId, checkUid, role) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(checkUid)) &&
        membershipDocForUid(orgId, checkUid).data.status == 'active' &&
        role in membershipDocForUid(orgId, checkUid).data.roles;
    }

    function inviterAuthorizedForOwnerInvite(orgId, inviterUid) {
      return hasOrgRoleForUid(orgId, inviterUid, 'contractorOwner') ||
        hasOrgRoleForUid(orgId, inviterUid, 'contractorCompanyOwner') ||
        hasOrgRoleForUid(orgId, inviterUid, 'supplierOwner');
    }

    // Re-verified at acceptance time as defense-in-depth: an Owner-role
    // invite is only honored if its original inviter is still (or ever was,
    // per current state) an org Owner. role is otherwise immutable after
    // creation (see invitationUpdateAllowed), so this closes the same gap
    // invitationRoleAllowedForActor closes at create time.
    function invitationOwnerRoleAcceptAllowed(orgId, role, invitedByUid) {
      return !(role == 'contractorOwner' || role == 'supplierOwner') ||
        inviterAuthorizedForOwnerInvite(orgId, invitedByUid);
    }

    function isProcurementManager(orgId) {
      return hasOrgRole(orgId, 'procurementManager');
    }

    // Canonical role values only — legacy values stay readable but are never
    // accepted on writes.
    function contractorOrgRoles() {
      return [
        'contractorOwner',
        'contractorAdmin',
        'procurementManager',
        'projectManager',
        'engineer',
        'contractorViewer'
      ];
    }

    function supplierOrgRoles() {
      return [
        'supplierOwner',
        'supplierAdmin',
        'supplierSales',
        'supplierOperations',
        'supplierViewer'
      ];
    }

    function roleValidForOrg(orgId, role) {
      return role != 'platformAdmin' && (
        (isContractorOrg(orgId) && role in contractorOrgRoles()) ||
        (isSupplierOrg(orgId) && role in supplierOrgRoles())
      );
    }

    function membershipRolesValid(orgId, roles) {
      return roles is list &&
        roles.size() == 1 &&
        roleValidForOrg(orgId, roles[0]);
    }

    // Updates that do not touch roles may keep a deprecated stored value;
    // any roles change must write a canonical value.
    function membershipRolesValidOrUnchanged(orgId) {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['roles']) ||
        membershipRolesValid(orgId, request.resource.data.roles);
    }

    function membershipCustomFieldsValid() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['grants']) || d.grants is list) &&
        (!d.keys().hasAny(['revokes']) || d.revokes is list) &&
        (!d.keys().hasAny(['orgWideProjectAccess']) ||
          d.orgWideProjectAccess is bool) &&
        (!d.keys().hasAny(['managerUid']) || d.managerUid is string) &&
        (!d.keys().hasAny(['team']) || d.team is string);
    }

    function membershipCoreFieldsPreserved() {
      return request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.orgType == resource.data.orgType;
    }

    function membershipOwnerDemotionBlocked(orgId, memberUid) {
      let org = orgDoc(orgId).data;
      let oldRoles = resource.data.roles;
      let newRoles = request.resource.data.roles;
      let demotingContractorOwner =
        ('contractorOwner' in oldRoles || 'contractorCompanyOwner' in oldRoles) &&
        !('contractorOwner' in newRoles ||
          'contractorCompanyOwner' in newRoles);
      let demotingSupplierOwner =
        'supplierOwner' in oldRoles &&
        !('supplierOwner' in newRoles);
      return (demotingContractorOwner || demotingSupplierOwner) &&
        org.keys().hasAny(['ownerUid']) &&
        org.ownerUid == memberUid &&
        !isPlatformAdmin();
    }

    function membershipAdminUpdateAllowed(orgId, memberUid) {
      return isPlatformAdmin() &&
        resource.data.orgId == orgId &&
        request.resource.data.orgId == orgId &&
        membershipCoreFieldsPreserved() &&
        membershipRolesValidOrUnchanged(orgId) &&
        membershipCustomFieldsValid() &&
        !membershipOwnerDemotionBlocked(orgId, memberUid) &&
        request.resource.data.status in ['active', 'disabled'] &&
        changedOnly([
          'roles',
          'status',
          'projectIds',
          'orgWideProjectAccess',
          'managerUid',
          'team',
          'grants',
          'revokes',
          'email',
          'displayName',
          'updatedAt',
          'updatedByUid'
        ]);
    }

    function membershipOwnerApprovalCreateAllowed(orgId, memberUid) {
      let targetUser = get(/databases/$(database)/documents/users/$(memberUid)).data;
      return canManageOrgMemberships(orgId) &&
        memberUid != uid() &&
        request.resource.data.orgId == orgId &&
        request.resource.data.orgType == orgTypeValue(orgId) &&
        request.resource.data.status == 'active' &&
        membershipRolesValid(orgId, request.resource.data.roles) &&
        !('platformAdmin' in request.resource.data.roles) &&
        targetUser.accountStatus == 'pendingApproval' &&
        (
          (targetUser.keys().hasAny(['requestedOrgId']) &&
            targetUser.requestedOrgId == orgId) ||
          (
            exists(/databases/$(database)/documents/accessRequests/$(memberUid)) &&
            get(/databases/$(database)/documents/accessRequests/$(memberUid)).data.requestedOrgId == orgId
          )
        );
    }

    function membershipManagerUpdateAllowed(orgId, memberUid) {
      return canManageOrgMemberships(orgId) &&
        memberUid != uid() &&
        resource.data.orgId == orgId &&
        request.resource.data.orgId == orgId &&
        membershipCoreFieldsPreserved() &&
        membershipRolesValidOrUnchanged(orgId) &&
        membershipCustomFieldsValid() &&
        !membershipOwnerDemotionBlocked(orgId, memberUid) &&
        request.resource.data.status in ['active', 'disabled'] &&
        changedOnly([
          'roles',
          'status',
          'projectIds',
          'orgWideProjectAccess',
          'managerUid',
          'team',
          'grants',
          'revokes',
          'updatedAt',
          'updatedByUid'
        ]);
    }

    function membershipUpdateAllowed(orgId, memberUid) {
      return membershipAdminUpdateAllowed(orgId, memberUid) ||
        membershipManagerUpdateAllowed(orgId, memberUid) ||
        (
          resource.data.orgId == orgId &&
          request.resource.data.orgId == orgId &&
          membershipCoreFieldsPreserved() &&
          changedOnly(['roles', 'updatedAt', 'updatedByUid']) &&
          request.resource.data.updatedByUid == uid() &&
          membershipRolesValid(orgId, request.resource.data.roles) &&
          !membershipOwnerDemotionBlocked(orgId, memberUid) &&
          canManageOrgMemberships(orgId) &&
          memberUid != uid()
        );
    }

    function membershipSelfOwnerCreateBlocked(memberUid) {
      return memberUid == uid() && (
        'contractorOwner' in request.resource.data.roles ||
        'contractorCompanyOwner' in request.resource.data.roles ||
        'supplierOwner' in request.resource.data.roles
      );
    }

    function invitationDoc(inviteId) {
      return get(/databases/$(database)/documents/invitations/$(inviteId));
    }

    // InvitationRepository.createInvitation always writes expiresAt (now +
    // 30 days); accept-time checks require it present and in the future so
    // a stale or leaked invite link can no longer be accepted indefinitely.
    function invitationNotExpired(invite) {
      return invite.keys().hasAny(['expiresAt']) &&
        invite.expiresAt is timestamp &&
        invite.expiresAt > request.time;
    }

    function membershipInviteAcceptCreateAllowed(orgId, memberUid) {
      let inviteId = request.resource.data.acceptedInvitationId;
      let invite = invitationDoc(inviteId);
      return memberUid == uid() &&
        request.resource.data.keys().hasAny(['acceptedInvitationId']) &&
        invite.data.status == 'pending' &&
        invitationNotExpired(invite.data) &&
        invite.data.email == request.auth.token.email &&
        invite.data.orgId == orgId &&
        request.resource.data.orgId == orgId &&
        request.resource.data.status == 'active' &&
        request.resource.data.roles.size() == 1 &&
        request.resource.data.roles[0] == invite.data.role &&
        membershipRolesValid(orgId, request.resource.data.roles) &&
        invitationOwnerRoleAcceptAllowed(
          orgId,
          invite.data.role,
          invite.data.get('invitedByUid', '')
        ) &&
        // Project-access mode and preassigned projects must mirror the invite;
        // custom grants/revokes can never be self-assigned on acceptance.
        !request.resource.data.keys().hasAny(['grants', 'revokes']) &&
        (!request.resource.data.keys().hasAny(['orgWideProjectAccess']) ||
          request.resource.data.orgWideProjectAccess ==
            invite.data.get('orgWideProjectAccess', false)) &&
        (!request.resource.data.keys().hasAny(['projectIds']) ||
          request.resource.data.projectIds ==
            invite.data.get('projectIds', []));
    }

    function membershipCreateAllowed(orgId, memberUid) {
      return membershipInviteAcceptCreateAllowed(orgId, memberUid) ||
        membershipOwnerBootstrapCreateAllowed(orgId, memberUid) ||
        membershipOwnerApprovalCreateAllowed(orgId, memberUid) || (
        isPlatformAdmin() &&
        request.resource.data.orgId == orgId &&
        request.resource.data.orgType == orgTypeValue(orgId) &&
        membershipRolesValid(orgId, request.resource.data.roles) &&
        !membershipSelfOwnerCreateBlocked(memberUid)
      );
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectDataOrgId(data) {
      return data.keys().hasAny(['orgId']) &&
        data.orgId is string &&
        data.orgId.size() > 0
        ? data.orgId
        : (
          data.keys().hasAny(['ownerUid']) &&
          data.ownerUid is string &&
          data.ownerUid.size() > 0
            ? data.ownerUid
            : ''
        );
    }

    function projectOrgId(projectId) {
      return projectDataOrgId(projectDoc(projectId).data);
    }

    // Org members see a project only with org-wide access; assigned-only
    // members are covered by the explicit assignment clause on /projects.
    function contractorOrgCanReadProject(data) {
      let orgId = projectDataOrgId(data);
      return orgId != '' && membershipHasOrgWideAccess(orgId);
    }

    function isProjectManagerFor(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/assignments/$(uid())) &&
        get(/databases/$(database)/documents/projects/$(projectId)/assignments/$(uid())).data.role == 'projectManager';
    }

    function canManageProjectAssignments(projectId) {
      return isPlatformAdmin() ||
        projectDoc(projectId).data.ownerUid == uid() ||
        (projectOrgId(projectId) != '' &&
          (canManageOrgMemberships(projectOrgId(projectId)) ||
            membershipHasGrant(projectOrgId(projectId), 'assignProjectMembers')) &&
          membershipLacksRevoke(projectOrgId(projectId), 'assignProjectMembers')) ||
        isProjectManagerFor(projectId);
    }

    function projectAssignmentRolesValid(role) {
      return role in [
        'projectManager',
        'engineer',
        'procurementManager',
        'contractorViewer'
      ];
    }

    // Accepting a pending invitation that preassigns projects lets the new
    // member materialize their own authoritative assignment docs.
    function projectAssignmentFromInvitationAllowed(projectId, assignUid) {
      let inviteId = request.resource.data.get('sourceInvitationId', '');
      return assignUid == uid() &&
        inviteId is string &&
        inviteId != '' &&
        exists(/databases/$(database)/documents/invitations/$(inviteId)) &&
        invitationDoc(inviteId).data.status == 'accepted' &&
        invitationDoc(inviteId).data.acceptedByUid == uid() &&
        invitationDoc(inviteId).data.orgId == request.resource.data.orgId &&
        projectId in invitationDoc(inviteId).data.get('projectIds', []) &&
        request.resource.data.role == invitationDoc(inviteId).data.role;
    }

    function projectAssignmentCreateAllowed(projectId, assignUid) {
      let orgOk = projectOrgId(projectId) == '' ||
        request.resource.data.orgId == projectOrgId(projectId);
      return (
          (canManageProjectAssignments(projectId) &&
            !(assignUid == uid() &&
              request.resource.data.role == 'projectManager')) ||
          projectAssignmentFromInvitationAllowed(projectId, assignUid)
        ) &&
        orgOk &&
        request.resource.data.projectId == projectId &&
        request.resource.data.uid == assignUid &&
        projectAssignmentRolesValid(request.resource.data.role);
    }

    function projectAssignmentUpdateAllowed(projectId, assignUid) {
      return canManageProjectAssignments(projectId) &&
        resource.data.projectId == projectId &&
        resource.data.uid == assignUid &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.orgId == resource.data.orgId &&
        !(assignUid == uid() &&
          request.resource.data.role == 'projectManager') &&
        projectAssignmentRolesValid(request.resource.data.role) &&
        changedOnly([
          'role',
          'updatedAt',
          'displayName',
          'email',
          'assignedByUid'
        ]);
    }

    function projectAssignmentReadAllowed(projectId, assignUid) {
      return isPlatformAdmin() ||
        assignUid == uid() ||
        projectDoc(projectId).data.ownerUid == uid() ||
        canManageProjectAssignments(projectId);
    }

    function invitationCreateAllowed() {
      let data = request.resource.data;
      return data.orgId is string &&
        canInviteOrgMembers(data.orgId) &&
        invitationRoleAllowedForActor(data.orgId, data.role) &&
        data.status == 'pending' &&
        data.invitedByUid == uid() &&
        data.email is string &&
        data.email.size() > 0 &&
        membershipRolesValid(data.orgId, [data.role]) &&
        (!data.keys().hasAny(['orgWideProjectAccess']) ||
          data.orgWideProjectAccess is bool) &&
        (!data.keys().hasAny(['projectIds']) || data.projectIds is list) &&
        !(data.email == request.auth.token.email && (
          data.role == 'contractorOwner' ||
          data.role == 'supplierOwner'
        ));
    }

    function invitationReadAllowed() {
      return isPlatformAdmin() ||
        canManageOrgMemberships(resource.data.orgId) ||
        (resource.data.status == 'pending' &&
          resource.data.email == request.auth.token.email);
    }

    function invitationUpdateAllowed() {
      return (
        isPlatformAdmin() ||
        (canManageOrgMemberships(resource.data.orgId) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.orgId == resource.data.orgId &&
          changedOnly([
            'status',
            'updatedAt',
            'cancelledAt',
            'deliveryStatus'
          ]))
      ) || (
        canManageOrgMemberships(resource.data.orgId) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.orgId == resource.data.orgId &&
        changedOnly(['deliveryStatus', 'updatedAt'])
      ) || (
        resource.data.status == 'pending' &&
        invitationNotExpired(resource.data) &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.acceptedByUid == uid() &&
        changedOnly([
          'status',
          'updatedAt',
          'deliveryStatus',
          'acceptedByUid',
          'acceptedAt'
        ])
      );
    }

    function hasProjectAuditRead(projectId) {
      return isPlatformAdmin() ||
        projectDoc(projectId).data.ownerUid == uid() ||
        isProjectManagerFor(projectId) ||
        exists(/databases/$(database)/documents/projects/$(projectId)/assignments/$(uid()));
    }

    // Client-written audit trail hardening: fixed field set, actor identity,
    // server timestamp, and no spoofing of organizations the actor is not a
    // member of. A trusted server-written audit path (Cloud Functions) should
    // eventually replace client writes entirely.
    function auditEventCreateAllowed() {
      let d = request.resource.data;
      return isSignedIn() &&
        d.actorUid == uid() &&
        d.entityType is string &&
        d.entityId is string &&
        d.action is string &&
        d.summaryHebrew is string &&
        d.keys().hasOnly([
          'actorUid',
          'actorEmail',
          'actorName',
          'orgId',
          'orgType',
          'projectId',
          'entityType',
          'entityId',
          'action',
          'summaryHebrew',
          'metadata',
          'createdAt'
        ]) &&
        (!d.keys().hasAny(['createdAt']) || d.createdAt == request.time) &&
        (!d.keys().hasAny(['orgId']) ||
          isPlatformAdmin() ||
          isOrgMember(d.orgId));
    }

    function auditEventReadAllowed() {
      return isPlatformAdmin() ||
        (resource.data.keys().hasAny(['orgId']) &&
          resource.data.orgId is string &&
          canManageOrgMemberships(resource.data.orgId)) ||
        (resource.data.keys().hasAny(['projectId']) &&
          resource.data.projectId is string &&
          hasProjectAuditRead(resource.data.projectId));
    }

    function hasProjectAccess(projectId) {
      return isSignedIn() && (
        isPlatformAdmin() ||
        (
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == uid()
        ) ||
        exists(/databases/$(database)/documents/projects/$(projectId)/assignments/$(uid()))
      );
    }

    function isProjectAssignee(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/assignments/$(uid()));
    }

    // Shipping via a supplier org requires the markOrderShipped permission
    // (owner/admin/operations roles, or an explicit grant, minus revokes).
    function supplierOrgCanShip(orgId) {
      return activeSupplierOrgMembership(orgId) &&
        (
          isSupplierAdminMember(orgId) ||
          isSupplierOperationsMember(orgId) ||
          membershipHasGrant(orgId, 'markOrderShipped')
        ) &&
        membershipLacksRevoke(orgId, 'markOrderShipped');
    }

    function supplierApprovedQuoteOwner(requestData) {
      return requestData.keys().hasAny(['approvedQuoteId']) &&
        requestData.approvedQuoteId is string &&
        requestData.approvedQuoteId.size() > 0 &&
        exists(/databases/$(database)/documents/supplierQuotes/$(requestData.approvedQuoteId)) &&
        (
          get(/databases/$(database)/documents/supplierQuotes/$(requestData.approvedQuoteId)).data.supplierId == uid() ||
          (
            get(/databases/$(database)/documents/supplierQuotes/$(requestData.approvedQuoteId)).data.keys().hasAny(['supplierOrgId']) &&
            supplierOrgCanShip(
              get(/databases/$(database)/documents/supplierQuotes/$(requestData.approvedQuoteId)).data.supplierOrgId
            )
          )
        );
    }

    function supplierOrderShipFields() {
      return [
        'status',
        'updatedAt',
        'shippedAt',
        'shippedBySupplierId',
        'shippedByUid',
        'shippedBySupplierOrgId',
        'receiptStatus',
      ];
    }

    function supplierCanMarkOrderShipped() {
      return isSupplier() &&
        resource.data.customerId == request.resource.data.customerId &&
        supplierApprovedQuoteOwner(resource.data) &&
        resource.data.status in ['הוזמנה', 'ordered'] &&
        request.resource.data.status in ['ממתין לאישור קבלה', 'pendingReceipt'] &&
        request.resource.data.receiptStatus == 'pending_receipt' &&
        changedOnly(supplierOrderShipFields());
    }

    function organizationOwnerBootstrapAllowed(orgId) {
      return false;
    }

    function membershipOwnerBootstrapCreateAllowed(orgId, memberUid) {
      return false;
    }

    function validProjectStatus(status) {
      return status in ['active', 'archived', 'completed', 'deletionPending'];
    }

    function projectDeletionFieldsValid() {
      return request.resource.data.status != 'deletionPending' ||
        (
          request.resource.data.deletionScheduledFor is timestamp &&
          request.resource.data.deletionScheduledFor > request.time
        );
    }

    function projectCreateOrgId() {
      return request.resource.data.keys().hasAny(['orgId']) &&
        request.resource.data.orgId is string &&
        request.resource.data.orgId.size() > 0
        ? request.resource.data.orgId
        : request.resource.data.ownerUid;
    }

    function projectCreateRoleAllowed() {
      let orgId = projectCreateOrgId();
      return isContractorAdminMember(orgId) &&
        membershipLacksRevoke(orgId, 'manageProjects') &&
        (
          request.resource.data.ownerUid == uid() ||
          request.resource.data.ownerUid == orgId
        );
    }

    function projectOwnerCreateAllowed() {
      return userHasActivePlatformAccess() &&
        projectCreateRoleAllowed() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        validProjectStatus(request.resource.data.status) &&
        request.resource.data.keys().hasAll(['createdAt', 'updatedAt']);
    }

    function projectOwnerUpdateAllowed() {
      return resource.data.ownerUid == uid() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        validProjectStatus(request.resource.data.status) &&
        projectDeletionFieldsValid();
    }

    function projectAdminCreateAllowed() {
      return request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid.size() > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        validProjectStatus(request.resource.data.status);
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function isCustomer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        userDoc().data.userType in ['privateCustomer', 'commercialCustomer'];
    }

    function isSupplier() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        userDoc().data.userType in ['privateSupplier', 'commercialSupplier'];
    }

    function hasInviteConstraints(data) {
      return (data.keys().hasAny(['invitedSupplierIds']) &&
          data.invitedSupplierIds.size() > 0) ||
        (data.keys().hasAny(['invitedSupplierOrgIds']) &&
          data.invitedSupplierOrgIds.size() > 0) ||
        (data.keys().hasAny(['invitedSupplierNames']) &&
          data.invitedSupplierNames.size() > 0);
    }

    function requestOpenToAllSuppliers(data) {
      return data.keys().hasAny(['openToAllSuppliers']) &&
        data.openToAllSuppliers == true;
    }

    function activeSupplierOrgMembership(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(uid())) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(uid())).data.status == 'active' &&
        isSupplierOrg(orgId);
    }

    function activeSupplierOrgCanQuote(orgId) {
      return activeSupplierOrgMembership(orgId) &&
        (
          isSupplierAdminMember(orgId) ||
          isSupplierSalesMember(orgId) ||
          membershipHasGrant(orgId, 'createSupplierQuote')
        ) &&
        membershipLacksRevoke(orgId, 'createSupplierQuote');
    }

    function supplierEligibleToQuoteRequest(data) {
      return isOpenRequestStatus(data.status) && (
        requestOpenToAllSuppliers(data) ||
        (data.keys().hasAny(['invitedSupplierIds']) &&
          data.invitedSupplierIds is list &&
          uid() in data.invitedSupplierIds) ||
        supplierInvitedByOrg(data)
      );
    }

    function supplierQuoteOrgEligibleForRequest(data, orgId) {
      return orgId is string &&
        orgId.size() > 0 &&
        activeSupplierOrgCanQuote(orgId) &&
        (
          requestOpenToAllSuppliers(data) ||
          (data.keys().hasAny(['invitedSupplierOrgIds']) &&
            data.invitedSupplierOrgIds is list &&
            orgId in data.invitedSupplierOrgIds) ||
          (data.keys().hasAny(['invitedSupplierIds']) &&
            data.invitedSupplierIds is list &&
            uid() in data.invitedSupplierIds)
        );
    }

    // Whether the write itself declares a supplierOrgId, as opposed to
    // acting purely as an individual. Kept boolean-only rather than a
    // ternary — some Firestore emulator versions mis-evaluate a ternary
    // nested this deep inside && chains (see supplierQuoteCreateOrgAllowed).
    function supplierQuoteHasOrgId(quoteData) {
      return quoteData.keys().hasAny(['supplierOrgId']) &&
        quoteData.supplierOrgId is string &&
        quoteData.supplierOrgId.size() > 0;
    }

    // Org-invited eligibility for actually CREATING a priced quote requires
    // the org's createSupplierQuote grant/revoke — stricter than
    // supplierInvitedByOrg (membership-only; used for read/response-tracking
    // eligibility elsewhere, where any org member should still see an RFQ
    // their org was invited to even without quote-creation rights).
    function supplierInvitedOrgCanQuote(data) {
      return data.keys().hasAny(['invitedSupplierOrgIds']) &&
        data.invitedSupplierOrgIds is list &&
        (
          (data.invitedSupplierOrgIds.size() > 0 &&
            activeSupplierOrgCanQuote(data.invitedSupplierOrgIds[0])) ||
          (data.invitedSupplierOrgIds.size() > 1 &&
            activeSupplierOrgCanQuote(data.invitedSupplierOrgIds[1])) ||
          (data.invitedSupplierOrgIds.size() > 2 &&
            activeSupplierOrgCanQuote(data.invitedSupplierOrgIds[2])) ||
          (data.invitedSupplierOrgIds.size() > 3 &&
            activeSupplierOrgCanQuote(data.invitedSupplierOrgIds[3])) ||
          (data.invitedSupplierOrgIds.size() > 4 &&
            activeSupplierOrgCanQuote(data.invitedSupplierOrgIds[4]))
        );
    }

    // Eligibility for the "solo" (no supplierOrgId) create branch. Mirrors
    // supplierEligibleToQuoteRequest but uses supplierInvitedOrgCanQuote
    // instead of supplierInvitedByOrg, so a create on a request that
    // invited the actor's org still requires that org's createSupplierQuote
    // grant/revoke even when the write omits supplierOrgId. The profile
    // check is only reached for the open-to-all/personal-invite paths —
    // ORed after (not alongside) supplierInvitedOrgCanQuote so an
    // org-invited pass short-circuits it, avoiding a second full
    // re-evaluation of activeSupplierOrgCanQuote for the same org.
    function supplierSoloCreateEligible(data) {
      return isOpenRequestStatus(data.status) && (
        supplierInvitedOrgCanQuote(data) ||
        (
          (
            requestOpenToAllSuppliers(data) ||
            (data.keys().hasAny(['invitedSupplierIds']) &&
              data.invitedSupplierIds is list &&
              uid() in data.invitedSupplierIds)
          ) &&
          supplierProfileOrgPermitsQuote()
        )
      );
    }

    // Defense-in-depth for the remaining solo-eligibility paths (open to
    // all suppliers, or personally invited) that have no specific org in
    // the request to check against: if the acting supplier's OWN profile
    // records a primary supplier org (set during admin approval — see
    // userOwnerApprovalUpdateAllowed), that org's createSupplierQuote
    // grant/revoke still applies. Not a full guarantee — this field is not
    // always populated (SupplierQuoteRepository falls back to a
    // collectionGroup membership lookup precisely because of that), and
    // Firestore rules cannot enumerate arbitrary org memberships without a
    // known orgId to check against — but this closes the gap whenever the
    // field is present.
    function supplierProfileOrgPermitsQuote() {
      let profileOrgId = userDoc().data.get('supplierOrgId', '');
      return profileOrgId == '' || activeSupplierOrgCanQuote(profileOrgId);
    }

    function supplierQuoteCreateOrgAllowed(linkedRequest, quoteData) {
      return (
        supplierQuoteHasOrgId(quoteData) &&
        supplierQuoteOrgEligibleForRequest(linkedRequest, quoteData.supplierOrgId)
      ) || (
        !supplierQuoteHasOrgId(quoteData) &&
        quoteData.supplierId == uid() &&
        supplierSoloCreateEligible(linkedRequest)
      );
    }

    function supplierCanUpdateRequestResponse(data) {
      return supplierEligibleToQuoteRequest(data) ||
        (data.keys().hasAny(['supplierIdsResponded']) &&
          data.supplierIdsResponded is list &&
          uid() in data.supplierIdsResponded);
    }

    function supplierInvitedByOrg(data) {
      return data.keys().hasAny(['invitedSupplierOrgIds']) &&
        data.invitedSupplierOrgIds is list &&
        (
          (data.invitedSupplierOrgIds.size() > 0 &&
            activeSupplierOrgMembership(data.invitedSupplierOrgIds[0])) ||
          (data.invitedSupplierOrgIds.size() > 1 &&
            activeSupplierOrgMembership(data.invitedSupplierOrgIds[1])) ||
          (data.invitedSupplierOrgIds.size() > 2 &&
            activeSupplierOrgMembership(data.invitedSupplierOrgIds[2])) ||
          (data.invitedSupplierOrgIds.size() > 3 &&
            activeSupplierOrgMembership(data.invitedSupplierOrgIds[3])) ||
          (data.invitedSupplierOrgIds.size() > 4 &&
            activeSupplierOrgMembership(data.invitedSupplierOrgIds[4]))
        );
    }

    // RFQ visibility follows project access: org-wide members see all org
    // requests; assigned-only members see requests of their assigned projects.
    function contractorOrgCanReadRequest(data) {
      let orgId = requestContractorOrgId(data);
      return orgId != '' && isOrgMember(orgId) && (
        membershipHasOrgWideAccess(orgId) ||
        (
          data.keys().hasAny(['projectId']) &&
          data.projectId is string &&
          data.projectId.size() > 0 &&
          isProjectAssignee(data.projectId)
        )
      );
    }

    function supplierCanReadRequest(data) {
      return isSupplier() && (
        supplierResponded(data) ||
        supplierEligibleToQuoteRequest(data)
      );
    }

    function supplierQuoteShippedUpdateAllowed() {
      return isSupplier() &&
        (
          resource.data.supplierId == uid() ||
          (
            resource.data.keys().hasAny(['supplierOrgId']) &&
            supplierOrgCanShip(resource.data.supplierOrgId)
          )
        ) &&
        resource.data.status in ['אושרה', 'approved'] &&
        request.resource.data.status in ['נשלחה', 'shipped'] &&
        changedOnly([
          'status',
          'seenOrderBySupplier',
          'updatedAt',
          'shippedAt',
          'shippedBySupplierId'
        ]);
    }

    function supplierTenderBidOutdateAllowed() {
      // A resubmitted tender bid supersedes the supplier's own prior
      // version — only that one status transition, nothing else.
      return isSupplier() &&
        resource.data.keys().hasAny(['isTenderBid']) &&
        resource.data.isTenderBid == true &&
        (
          resource.data.supplierId == uid() ||
          supplierOrgMemberCanAccessQuote(resource.data)
        ) &&
        resource.data.status in ['נשלח', 'sent'] &&
        request.resource.data.status in ['לא מעודכנת', 'outdated'] &&
        changedOnly(['status']);
    }

    function isOpenRequestStatus(status) {
      return status in ['נשלח', 'התקבלו הצעות', 'sent', 'quotesReceived'];
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    function requestDoc(requestId) {
      return get(/databases/$(database)/documents/quoteRequests/$(requestId));
    }

    function supplierQuoteDoc(quoteId) {
      return get(/databases/$(database)/documents/supplierQuotes/$(quoteId));
    }

    function quoteHasCustomerId(data) {
      return data.keys().hasAny(['customerId']);
    }

    function quoteBelongsToCustomer(data) {
      return quoteHasCustomerId(data) && data.customerId == uid();
    }

    function supplierResponded(data) {
      return data.keys().hasAny(['supplierIdsResponded']) &&
        uid() in data.supplierIdsResponded;
    }

    function validUserType(userType) {
      return userType in [
        'privateCustomer',
        'commercialCustomer',
        'privateSupplier',
        'commercialSupplier'
      ];
    }

    function userHasActivePlatformAccess() {
      return !exists(/databases/$(database)/documents/users/$(uid())) ||
        !userDoc().data.keys().hasAny(['accountStatus']) ||
        userDoc().data.accountStatus == 'active';
    }

    function userPendingApproval() {
      return exists(/databases/$(database)/documents/users/$(uid())) &&
        userDoc().data.keys().hasAny(['accountStatus']) &&
        userDoc().data.accountStatus == 'pendingApproval';
    }

    function userCreateAllowed() {
      return request.resource.data.uid == uid() &&
        validUserType(request.resource.data.userType) &&
        request.resource.data.verified == false &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        (!request.resource.data.keys().hasAny(['accountStatus']) ||
          request.resource.data.accountStatus == 'pendingApproval') &&
        (!request.resource.data.keys().hasAny(['requestedOrgName']) ||
          request.resource.data.requestedOrgName is string) &&
        (!request.resource.data.keys().hasAny(['requestedOrgType']) ||
          request.resource.data.requestedOrgType in ['contractor', 'supplier']);
    }

    function userOwnerApprovalUpdateAllowed(userId) {
      let target = get(/databases/$(database)/documents/users/$(userId)).data;
      return resource.data.accountStatus == 'pendingApproval' &&
        request.resource.data.accountStatus in ['active', 'rejected'] &&
        changedOnly([
          'accountStatus',
          'updatedAt',
          'orgId',
          'primaryOrgId',
          'supplierOrgId'
        ]) &&
        (
          isPlatformAdmin() ||
          (
            target.keys().hasAny(['requestedOrgId']) &&
            target.requestedOrgId is string &&
            target.requestedOrgId.size() > 0 &&
            canManageOrgMemberships(target.requestedOrgId) &&
            request.resource.data.primaryOrgId == target.requestedOrgId
          ) ||
          (
            exists(/databases/$(database)/documents/accessRequests/$(userId)) &&
            get(/databases/$(database)/documents/accessRequests/$(userId)).data.requestedOrgId is string &&
            get(/databases/$(database)/documents/accessRequests/$(userId)).data.requestedOrgId.size() > 0 &&
            canManageOrgMemberships(
              get(/databases/$(database)/documents/accessRequests/$(userId)).data.requestedOrgId
            ) &&
            request.resource.data.primaryOrgId ==
              get(/databases/$(database)/documents/accessRequests/$(userId)).data.requestedOrgId
          )
        );
    }

    function userOrgManagerStatusUpdateAllowed(userId) {
      return userId != uid() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        resource.data.keys().hasAny(['primaryOrgId']) &&
        resource.data.primaryOrgId is string &&
        resource.data.primaryOrgId.size() > 0 &&
        canManageOrgMemberships(resource.data.primaryOrgId) &&
        changedOnly(['accountStatus', 'updatedAt']) &&
        request.resource.data.accountStatus in ['active', 'disabled', 'blocked'] &&
        resource.data.accountStatus in ['active', 'disabled', 'blocked'];
    }

    function userAdminApprovalUpdateAllowed() {
      return changedOnly(['accountStatus', 'updatedAt']) &&
        request.resource.data.accountStatus in [
          'active',
          'blocked',
          'disabled',
          'rejected',
          'pendingApproval'
        ];
    }

    function userAdminCreateAllowed(userId) {
      return request.resource.data.uid == userId &&
        validUserType(request.resource.data.userType) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.accountStatus in [
          'active',
          'blocked',
          'disabled',
          'rejected',
          'pendingApproval'
        ];
    }

    function userAdminManagementUpdateAllowed() {
      return validUserType(request.resource.data.userType) &&
        request.resource.data.accountStatus in [
          'active',
          'blocked',
          'disabled',
          'rejected',
          'pendingApproval'
        ] &&
        changedOnly([
          'accountStatus',
          'updatedAt',
          'fullName',
          'name',
          'phone',
          'city',
          'userType',
          'verified',
          'orgId',
          'primaryOrgId',
          'supplierOrgId'
        ]);
    }

    function supplierDirectoryAdminWriteAllowed() {
      return request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.orgId is string &&
        request.resource.data.orgId.size() > 0 &&
        (
          !request.resource.data.keys().hasAny(['active']) ||
          request.resource.data.active is bool
        );
    }

    function userProfileUpdateAllowed() {
      return changedOnly([
          'name',
          'fullName',
          'phone',
          'city',
          'notes',
          'updatedAt'
        ]) &&
        request.resource.data.userType == resource.data.userType &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email;
    }

    function validQuoteRequestStatus(status) {
      return status in [
        'נשלח',
        'sent',
        'התקבלו הצעות',
        'quotesReceived',
        'הוזמנה',
        'ordered',
        'נשלחה',
        'shipped',
        'ממתין לאישור קבלה',
        'pendingReceipt',
        'התקבל במלואו',
        'receivedFull',
        'התקבל עם חריגות',
        'receivedWithIssues',
        'הושלמה',
        'completed',
        'בוטלה',
        'cancelled',
        'נסגר',
        'closed',
        'טיוטה',
        'draft',
        'ממתין לאישור רכש',
        'pendingApproval',
        'אושר על ידי רכש',
        'procurementApproved',
        'נדחה על ידי רכש',
        'procurementRejected'
      ];
    }

    function requestContractorOrgId(data) {
      return data.keys().hasAny(['contractorOrgId']) &&
        data.contractorOrgId is string &&
        data.contractorOrgId.size() > 0
        ? data.contractorOrgId
        : requestContractorOrgIdFromProject(data);
    }

    function requestContractorOrgIdFromProject(data) {
      return data.keys().hasAny(['projectId']) &&
        data.projectId is string &&
        data.projectId.size() > 0 &&
        exists(/databases/$(database)/documents/projects/$(data.projectId)) &&
        get(/databases/$(database)/documents/projects/$(data.projectId)).data
          .keys().hasAny(['orgId']) &&
        get(/databases/$(database)/documents/projects/$(data.projectId)).data.orgId is string &&
        get(/databases/$(database)/documents/projects/$(data.projectId)).data.orgId.size() > 0
        ? get(/databases/$(database)/documents/projects/$(data.projectId)).data.orgId
        : '';
    }

    function canApproveProcurementForRequest(data) {
      let orgId = requestContractorOrgId(data);
      return orgId != '' &&
        (
          hasOrgRole(orgId, 'procurementManager') ||
          isContractorAdminMember(orgId) ||
          membershipHasGrant(orgId, 'approveRfq')
        ) &&
        membershipLacksRevoke(orgId, 'approveRfq');
    }

    function procurementRfqApprovalUpdateAllowed() {
      return canApproveProcurementForRequest(resource.data) &&
        resource.data.status in [
          'ממתין לאישור רכש',
          'pendingApproval'
        ] &&
        request.resource.data.status in [
          'אושר על ידי רכש',
          'procurementApproved',
          'נדחה על ידי רכש',
          'procurementRejected'
        ] &&
        request.resource.data.customerId == resource.data.customerId &&
        changedOnly([
          'status',
          'procurementApprovedByUid',
          'procurementRejectedByUid',
          'procurementRejectionNote',
          'updatedAt'
        ]);
    }

    function procurementRfqSendUpdateAllowed() {
      return canApproveProcurementForRequest(resource.data) &&
        resource.data.status in [
          'אושר על ידי רכש',
          'procurementApproved'
        ] &&
        request.resource.data.status in ['נשלח', 'sent'] &&
        request.resource.data.customerId == resource.data.customerId &&
        changedOnly([
          'status',
          'submittedByUid',
          'invitedSupplierIds',
          'invitedSupplierNames',
          'invitedSupplierOrgIds',
          'openToAllSuppliers',
          'updatedAt'
        ]);
    }

    function requestApprovedQuoteIdUnset(data) {
      return !data.keys().hasAny(['approvedQuoteId']) ||
        data.approvedQuoteId == null ||
        (data.approvedQuoteId is string && data.approvedQuoteId.size() == 0);
    }

    function requestAllowsFirstQuoteApproval(data) {
      return data.status in [
        'התקבלו הצעות',
        'quotesReceived',
        'נשלח',
        'sent'
      ] &&
        requestApprovedQuoteIdUnset(data);
    }

    function procurementApprovedQuoteIdValidForRequest() {
      let quoteId = request.resource.data.approvedQuoteId;
      let quotePath = /databases/$(database)/documents/supplierQuotes/$(quoteId);
      let quoteData = get(quotePath).data;
      let linkedRequestId = quoteData.keys().hasAny(['requestId']) &&
        quoteData.requestId is string &&
        quoteData.requestId.size() > 0
        ? quoteData.requestId
        : quoteData.quoteRequestId;
      return request.resource.data.keys().hasAny(['approvedQuoteId']) &&
        quoteId is string &&
        quoteId.size() > 0 &&
        exists(quotePath) &&
        linkedRequestId == resource.id;
    }

    function procurementQuoteOrderUpdateAllowed() {
      return canApproveProcurementForRequest(resource.data) &&
        request.resource.data.customerId == resource.data.customerId &&
        requestAllowsFirstQuoteApproval(resource.data) &&
        request.resource.data.status in ['הוזמנה', 'ordered'] &&
        procurementApprovedQuoteIdValidForRequest() &&
        changedOnly(['status', 'approvedQuoteId', 'updatedAt']);
    }

    function contractorReceiptConfirmationFields() {
      return [
        'status',
        'receiptStatus',
        'receiptChecklist',
        'receivedAt',
        'receivedByUid',
        'receivedByRole',
        'receiptNotes',
        'updatedAt',
      ];
    }

    function requestReceiptPending(data) {
      return data.status in [
          'ממתין לאישור קבלה',
          'pendingReceipt',
          'נשלחה',
          'shipped'
        ] &&
        (
          !data.keys().hasAny(['receiptStatus']) ||
          data.receiptStatus == 'pending_receipt'
        );
    }

    function requestReceiptAlreadyFinal(data) {
      return data.keys().hasAny(['receiptStatus']) &&
        data.receiptStatus in ['received_full', 'received_with_issues'];
    }

    // Mirrors contractorOrgCanReadRequest's project-assignment scoping: org
    // roles that default to org-wide access (procurementManager, admin/owner)
    // pass unconditionally; engineer/projectManager (and grant-only actors)
    // must additionally be assigned to the request's own project.
    function canConfirmReceiptForRequest(data) {
      let orgId = requestContractorOrgId(data);
      return orgId != '' &&
        (
          hasOrgRole(orgId, 'procurementManager') ||
          isContractorAdminMember(orgId) ||
          hasOrgRole(orgId, 'engineer') ||
          hasOrgRole(orgId, 'projectManager') ||
          membershipHasGrant(orgId, 'confirmDeliveryReceipt')
        ) &&
        membershipLacksRevoke(orgId, 'confirmDeliveryReceipt') &&
        (
          membershipHasOrgWideAccess(orgId) ||
          (
            data.keys().hasAny(['projectId']) &&
            data.projectId is string &&
            data.projectId.size() > 0 &&
            isProjectAssignee(data.projectId)
          )
        );
    }

    function contractorReceiptConfirmationAllowed() {
      return canConfirmReceiptForRequest(resource.data) &&
        requestReceiptPending(resource.data) &&
        !requestReceiptAlreadyFinal(resource.data) &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.receiptStatus in [
          'received_full',
          'received_with_issues'
        ] &&
        request.resource.data.status in [
          'התקבל במלואו',
          'receivedFull',
          'התקבל עם חריגות',
          'receivedWithIssues'
        ] &&
        request.resource.data.receivedByUid == uid() &&
        changedOnly(contractorReceiptConfirmationFields());
    }

    function customerReceiptConfirmationAllowed() {
      return isCustomer() &&
        resource.data.customerId == uid() &&
        requestReceiptPending(resource.data) &&
        !requestReceiptAlreadyFinal(resource.data) &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.receiptStatus in [
          'received_full',
          'received_with_issues'
        ] &&
        request.resource.data.status in [
          'התקבל במלואו',
          'receivedFull',
          'התקבל עם חריגות',
          'receivedWithIssues'
        ] &&
        request.resource.data.receivedByUid == uid() &&
        changedOnly(contractorReceiptConfirmationFields());
    }

    function contractorOrgCanReadSupplierQuote(data) {
      return data.keys().hasAny(['requestId']) &&
        contractorOrgCanReadRequest(requestDoc(data.requestId).data);
    }

    function contractorQuoteApprovalRequestAllows(linkedRequestId) {
      let req = requestDoc(linkedRequestId).data;
      let approving = request.resource.data.status in ['אושרה', 'approved'];
      return !approving || requestAllowsFirstQuoteApproval(req);
    }

    // Approving/rejecting a quote requires the approveQuote permission —
    // not merely read access to the linked request.
    function contractorOrgCanApproveQuote(data) {
      let orgId = requestContractorOrgId(requestDoc(data.requestId).data);
      return orgId != '' &&
        (
          hasOrgRole(orgId, 'procurementManager') ||
          isContractorAdminMember(orgId) ||
          membershipHasGrant(orgId, 'approveQuote')
        ) &&
        membershipLacksRevoke(orgId, 'approveQuote');
    }

    // A customer may only move a quote to approved/rejected directly when
    // the linked request belongs to no organization (private/self-service
    // customers, who have no procurement org to route approval through).
    // Org-linked requests must go through contractorOrgQuoteStatusUpdateAllowed
    // (the approveQuote-gated path) — reuses the same first-approval guard
    // procurement approval already uses.
    function customerCanApproveOrRejectQuote(quoteData) {
      let approving = request.resource.data.status in ['אושרה', 'approved'];
      let rejecting = request.resource.data.status in ['נדחתה', 'rejected'];
      return (!approving && !rejecting) ||
        (
          requestContractorOrgId(requestDoc(quoteData.requestId).data) == '' &&
          contractorQuoteApprovalRequestAllows(quoteData.requestId)
        );
    }

    function contractorOrgQuoteStatusUpdateAllowed() {
      return contractorOrgCanReadSupplierQuote(resource.data) &&
        contractorOrgCanApproveQuote(resource.data) &&
        contractorQuoteApprovalRequestAllows(resource.data.requestId) &&
        request.resource.data.status in [
          'אושרה',
          'approved',
          'נדחתה',
          'rejected'
        ] &&
        changedOnly(['status', 'seenOrderBySupplier', 'seenByCustomer', 'updatedAt']);
    }

    function validSupplierQuoteStatus(status) {
      return status in [
        'נשלח',
        'אושרה',
        'נדחתה',
        'נשלחה',
        'לא נבחרה',
        'לא מעודכנת'
      ];
    }

    function validRequestItem(item) {
      return item is map &&
        item.keys().hasAll([
          'productId',
          'productName',
          'category',
          'unitType',
          'quantity'
        ]) &&
        item.productId is string &&
        item.productId.size() > 0 &&
        item.productName is string &&
        item.productName.size() > 0 &&
        item.category is string &&
        item.unitType is string &&
        item.quantity is int &&
        item.quantity > 0 &&
        item.quantity <= 999999 &&
        (!('notes' in item) || item.notes is string) &&
        (!('variantId' in item) || item.variantId is string) &&
        (!('isCatalogMatched' in item) || item.isCatalogMatched is bool) &&
        (!('attributesSnapshot' in item) || item.attributesSnapshot is map);
    }

    function validRequestItemsList(items) {
      return items is list &&
        items.size() > 0 &&
        items.size() <= 200;
    }

    function requestItemsUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['items']) ||
        validRequestItemsList(request.resource.data.items);
    }

    function validSupplierQuoteItem(item) {
      return item is map &&
        item.keys().hasAll([
          'productId',
          'productName',
          'requestedQuantity',
          'unitPrice',
          'totalItemPrice'
        ]) &&
        item.productId is string &&
        item.productId.size() > 0 &&
        item.productName is string &&
        item.productName.size() > 0 &&
        item.requestedQuantity is int &&
        item.requestedQuantity > 0 &&
        item.requestedQuantity <= 999999 &&
        item.unitPrice is number &&
        item.unitPrice >= 0 &&
        item.totalItemPrice is number &&
        item.totalItemPrice >= 0 &&
        (!('variantId' in item) || item.variantId is string) &&
        (!('quotedSku' in item) || item.quotedSku is string) &&
        (!('quotedName' in item) || item.quotedName is string) &&
        (!('isExactMatch' in item) || item.isExactMatch is bool) &&
        (!('isAlternative' in item) || item.isAlternative is bool) &&
        (!('attributesSnapshot' in item) || item.attributesSnapshot is map);
    }

    function validSupplierQuoteItemsList(items) {
      return items is list &&
        items.size() > 0 &&
        items.size() <= 200;
    }

    function validLegacyRequestItem(data) {
      return data.keys().hasAll([
          'quoteRequestId',
          'productId',
          'productName',
          'quantity'
        ]) &&
        data.quoteRequestId is string &&
        data.productId is string &&
        data.productName is string &&
        data.quantity is int &&
        data.quantity > 0;
    }

    function validLegacySupplierQuoteItem(data) {
      return data.keys().hasAll([
          'supplierQuoteId',
          'productId',
          'productName',
          'requestedQuantity',
          'unitPrice',
          'totalItemPrice'
        ]) &&
        data.supplierQuoteId is string &&
        data.productId is string &&
        data.productName is string &&
        data.requestedQuantity is int &&
        data.requestedQuantity > 0 &&
        data.unitPrice is number &&
        data.unitPrice >= 0 &&
        data.totalItemPrice is number &&
        data.totalItemPrice >= 0;
    }

    // Rejects a spoofed contractorOrgId/projectId on RFQ creation — mirrors
    // projectCreateRoleAllowed's approach of validating a client-supplied
    // orgId against real membership, reusing the same org/project resolver
    // and access helpers the read/procurement rules already use.
    function quoteRequestCreatorHasOrgAccess() {
      let orgId = requestContractorOrgId(request.resource.data);
      let projectId = request.resource.data.get('projectId', '');
      return orgId == '' ||
        (
          isOrgMember(orgId) &&
          (
            projectId == '' ||
            membershipHasOrgWideAccess(orgId) ||
            isProjectAssignee(projectId)
          )
        );
    }

    function quoteRequestCreateAllowed() {
      return userHasActivePlatformAccess() &&
        quoteRequestCreatorHasOrgAccess() &&
        request.resource.data.keys().hasAll([
          'customerId',
          'customerName',
          'customerPhone',
          'customerCity',
          'customerType',
          'status',
          'items',
          'createdAt'
        ]) &&
        request.resource.data.customerId == uid() &&
        request.resource.data.customerType == userDoc().data.userType &&
        (
          request.resource.data.status in [
            'טיוטה',
            'draft',
            'ממתין לאישור רכש',
            'pendingApproval'
          ] ||
          (
            request.resource.data.status in ['נשלח', 'sent'] &&
            canApproveProcurementForRequest(request.resource.data)
          )
        ) &&
        validQuoteRequestStatus(request.resource.data.status) &&
        validRequestItemsList(request.resource.data.items) &&
        request.resource.data.supplierIdsResponded.size() == 0;
    }

    function activeSupplierOrgListable() {
      return resource.data.type == 'supplier' &&
        resource.data.status == 'active';
    }

    function supplierOrgMemberCanAccessQuote(data) {
      return data.keys().hasAny(['supplierOrgId']) &&
        data.supplierOrgId is string &&
        data.supplierOrgId.size() > 0 &&
        activeSupplierOrgMembership(data.supplierOrgId);
    }

    function customerQuoteStatusUpdateAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status']) ||
        request.resource.data.status in [
          'טיוטה',
          'draft',
          'ממתין לאישור רכש',
          'pendingApproval'
        ];
    }

    // approvedQuoteId may only be set by a customer directly when the
    // request belongs to no organization (private/self-service customers
    // with no procurement org to route order approval through). Org-linked
    // requests must go through procurementQuoteOrderUpdateAllowed. Reuses
    // the same referenced-quote and first-approval validation the
    // procurement path already applies.
    function customerApprovedQuoteIdChangeAllowed() {
      let touchesApprovedQuoteId = request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['approvedQuoteId']);
      return !touchesApprovedQuoteId ||
        (
          requestContractorOrgId(resource.data) == '' &&
          requestAllowsFirstQuoteApproval(resource.data) &&
          procurementApprovedQuoteIdValidForRequest() &&
          request.resource.data.status in ['הוזמנה', 'ordered']
        );
    }

    function supplierQuoteCreateAllowed() {
      let requestId = request.resource.data.requestId;
      let linkedRequest = requestDoc(requestId);
      return request.resource.data.keys().hasAll([
          'requestId',
          'supplierId',
          'supplierName',
          'status',
          'items',
          'createdAt'
        ]) &&
        exists(/databases/$(database)/documents/quoteRequests/$(requestId)) &&
        request.resource.data.supplierId == uid() &&
        request.resource.data.status == 'נשלח' &&
        validSupplierQuoteStatus(request.resource.data.status) &&
        request.resource.data.customerId == linkedRequest.data.customerId &&
        supplierEligibleToQuoteRequest(linkedRequest.data) &&
        supplierQuoteCreateOrgAllowed(linkedRequest.data, request.resource.data) &&
        validSupplierQuoteItemsList(request.resource.data.items) &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice >= 0 &&
        (!('subtotal' in request.resource.data) ||
          (request.resource.data.subtotal is number &&
            request.resource.data.subtotal >= 0)) &&
        (!('deliveryCost' in request.resource.data) ||
          (request.resource.data.deliveryCost is number &&
            request.resource.data.deliveryCost >= 0)) &&
        (!('seenByCustomer' in request.resource.data) ||
          request.resource.data.seenByCustomer == false);
    }

    function supplierQuoteOrgKey(data) {
      return data.keys().hasAny(['supplierOrgId']) &&
        data.supplierOrgId is string &&
        data.supplierOrgId.size() > 0
        ? data.supplierOrgId
        : data.supplierId;
    }

    function supplierQuoteDeterministicDocId(quoteId, data) {
      // Tender bids keep one doc per version (bid history + outdating), so
      // they're deterministic per-version instead of per-request.
      return quoteId == data.requestId + '__' + supplierQuoteOrgKey(data) ||
        (
          data.keys().hasAny(['isTenderBid']) &&
          data.isTenderBid == true &&
          data.keys().hasAny(['bidVersion']) &&
          quoteId == data.requestId + '__' + supplierQuoteOrgKey(data) +
            '__v' + string(data.bidVersion)
        );
    }

    function supplierQuoteInactiveStatus(status) {
      return status in [
        'נדחתה',
        'rejected',
        'לא נבחרה',
        'notSelected',
        'לא מעודכנת',
        'outdated'
      ];
    }

    function supplierQuoteDuplicateCreateBlocked(quoteId) {
      return !exists(/databases/$(database)/documents/supplierQuotes/$(quoteId)) ||
        supplierQuoteInactiveStatus(
          get(/databases/$(database)/documents/supplierQuotes/$(quoteId)).data.status
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isPlatformAdmin());
      allow create: if isSignedIn() && (
        (uid() == userId && userCreateAllowed()) ||
        (isPlatformAdmin() && userAdminCreateAllowed(userId))
      );
      allow update: if isSignedIn() && (
        (uid() == userId && userProfileUpdateAllowed()) ||
        userOwnerApprovalUpdateAllowed(userId) ||
        userOrgManagerStatusUpdateAllowed(userId) ||
        (isPlatformAdmin() &&
          (userAdminApprovalUpdateAllowed() || userAdminManagementUpdateAllowed()))
      );
      allow delete: if false;
    }

    match /accessRequests/{requestUid} {
      allow read: if isPlatformAdmin() ||
        (
          resource.data.keys().hasAny(['requestedOrgId']) &&
          resource.data.requestedOrgId is string &&
          resource.data.requestedOrgId.size() > 0 &&
          canManageOrgMemberships(resource.data.requestedOrgId)
        );
      allow create: if isSignedIn() &&
        requestUid == uid() &&
        request.resource.data.uid == uid() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.email is string &&
        request.resource.data.fullName is string;
      allow update: if isPlatformAdmin() ||
        (
          resource.data.keys().hasAny(['requestedOrgId']) &&
          resource.data.requestedOrgId is string &&
          canManageOrgMemberships(resource.data.requestedOrgId) &&
          request.resource.data.status in ['approved', 'rejected'] &&
          changedOnly(['status', 'resolvedByUid', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /catalogCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /catalogProducts/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /catalogVariants/{variantId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Catalog snapshot + match fields (variantId, isCatalogMatched, isExactMatch,
    // isAlternative, quotedSku, etc.) are stored inside embedded items[] on
    // quoteRequests and supplierQuotes — list size and scalar fields validated here.

    match /catalogMeta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /appMeta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Public supplier directory for contractor targeting (admin/backfill only).
    match /supplierDirectory/{supplierUid} {
      allow read: if isSignedIn();
      allow create, update: if isPlatformAdmin() && supplierDirectoryAdminWriteAllowed();
      allow delete: if false;
    }

    // Contractor projects — owner-scoped; platform admin can manage all.
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.ownerUid == uid() ||
        isProjectAssignee(projectId) ||
        contractorOrgCanReadProject(resource.data)
      );
      allow create: if isSignedIn() && (
        projectOwnerCreateAllowed() ||
        (isPlatformAdmin() && projectAdminCreateAllowed())
      );
      allow update: if isSignedIn() && (
        projectOwnerUpdateAllowed() ||
        isPlatformAdmin()
      );
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow get: if isSignedIn() && (
        isOrgMember(orgId) ||
        isPlatformAdmin() ||
        (isCustomer() && activeSupplierOrgListable())
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin() ||
        (isCustomer() &&
          resource.data.type == 'supplier' &&
          resource.data.status == 'active') ||
        (userPendingApproval() && resource.data.status == 'active')
      );
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin();
      allow delete: if false;
    }

    match /organizations/{orgId}/memberships/{memberUid} {
      allow read: if isSignedIn() && (
        memberUid == uid() ||
        resource.data.uid == uid() ||
        isOrgMember(orgId) ||
        isPlatformAdmin()
      );
      allow create: if isSignedIn() &&
        membershipCreateAllowed(orgId, memberUid);
      allow update: if isSignedIn() &&
        membershipUpdateAllowed(orgId, memberUid);
      allow delete: if isPlatformAdmin();
    }

    match /invitations/{inviteId} {
      allow read: if isSignedIn() && invitationReadAllowed();
      allow create: if isSignedIn() && invitationCreateAllowed();
      allow update: if isSignedIn() && invitationUpdateAllowed();
      allow delete: if isPlatformAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isSignedIn() && auditEventReadAllowed();
      allow create: if isSignedIn() && auditEventCreateAllowed();
      allow update, delete: if false;
    }

    match /projects/{projectId}/assignments/{assignUid} {
      allow read: if isSignedIn() && (
        projectAssignmentReadAllowed(projectId, assignUid) ||
        resource.data.uid == uid()
      );
      allow create: if isSignedIn() &&
        projectAssignmentCreateAllowed(projectId, assignUid);
      allow update: if isSignedIn() &&
        projectAssignmentUpdateAllowed(projectId, assignUid);
      allow delete: if isSignedIn() &&
        canManageProjectAssignments(projectId);
    }

    match /quoteRequests/{requestId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.customerId == uid() ||
        contractorOrgCanReadRequest(resource.data) ||
        supplierCanReadRequest(resource.data)
      );

      allow create: if isCustomer() && quoteRequestCreateAllowed();

      allow update: if isSignedIn() &&
        validQuoteRequestStatus(request.resource.data.status) &&
        requestItemsUnchangedOrValid() && (
        (
          isCustomer() &&
          resource.data.customerId == uid() &&
          request.resource.data.customerId == resource.data.customerId &&
          customerQuoteStatusUpdateAllowed() &&
          customerApprovedQuoteIdChangeAllowed() &&
          changedOnly([
            'items',
            'notes',
            'supplierIdsResponded',
            'seenBySupplierIds',
            'customerLastSeenStatus',
            'status',
            'approvedQuoteId',
            'tenderClosed',
            'updatedAt'
          ])
        ) ||
        (
          isSupplier() &&
          isOpenRequestStatus(resource.data.status) &&
          supplierCanUpdateRequestResponse(resource.data) &&
          (
            changedOnly(['seenBySupplierIds']) ||
            (
              changedOnly([
                'status',
                'supplierIdsResponded',
                'lowestBid',
                'updatedAt'
              ]) &&
              request.resource.data.status == 'התקבלו הצעות' &&
              uid() in request.resource.data.supplierIdsResponded
            )
          ) &&
          request.resource.data.customerId == resource.data.customerId
        ) ||
        supplierCanMarkOrderShipped() ||
        contractorReceiptConfirmationAllowed() ||
        customerReceiptConfirmationAllowed() ||
        procurementRfqApprovalUpdateAllowed() ||
        procurementRfqSendUpdateAllowed() ||
        procurementQuoteOrderUpdateAllowed()
      );

      allow delete: if isCustomer() && resource.data.customerId == uid();
    }

    // Mirrors the /quoteRequests read rule via the linked request doc.
    function quoteRequestItemReadAllowed(data) {
      let req = requestDoc(data.quoteRequestId).data;
      return isPlatformAdmin() ||
        req.customerId == uid() ||
        contractorOrgCanReadRequest(req) ||
        supplierCanReadRequest(req);
    }

    match /quoteRequestItems/{itemId} {
      allow read: if isSignedIn() && quoteRequestItemReadAllowed(resource.data);
      allow create: if isCustomer() &&
        validLegacyRequestItem(request.resource.data) &&
        requestDoc(request.resource.data.quoteRequestId).data.customerId == uid();
      allow update, delete: if false;
    }

    match /supplierQuotes/{quoteId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.supplierId == uid() ||
        supplierOrgMemberCanAccessQuote(resource.data) ||
        quoteBelongsToCustomer(resource.data) ||
        requestDoc(resource.data.requestId).data.customerId == uid() ||
        contractorOrgCanReadSupplierQuote(resource.data)
      );

      allow create: if isSupplier() &&
        supplierQuoteCreateAllowed() &&
        supplierQuoteDeterministicDocId(quoteId, request.resource.data) &&
        supplierQuoteDuplicateCreateBlocked(quoteId) &&
        isOpenRequestStatus(requestDoc(request.resource.data.requestId).data.status);

      allow update: if isSignedIn() &&
        validSupplierQuoteStatus(request.resource.data.status) && (
        (
          isCustomer() &&
          (
            quoteBelongsToCustomer(resource.data) ||
            requestDoc(resource.data.requestId).data.customerId == uid()
          ) &&
          customerCanApproveOrRejectQuote(resource.data) &&
          changedOnly(['status', 'seenOrderBySupplier', 'seenByCustomer'])
        ) ||
        contractorOrgQuoteStatusUpdateAllowed() ||
        (
          isSupplier() &&
          (
            resource.data.supplierId == uid() ||
            supplierOrgMemberCanAccessQuote(resource.data)
          ) &&
          (
            changedOnly(['seenOrderBySupplier']) ||
            supplierQuoteShippedUpdateAllowed() ||
            supplierTenderBidOutdateAllowed()
          )
        )
      );
    }

    // Mirrors the /supplierQuotes read rule via the linked quote doc.
    function supplierQuoteItemReadAllowed(data) {
      let quote = supplierQuoteDoc(data.supplierQuoteId).data;
      return isPlatformAdmin() ||
        quote.supplierId == uid() ||
        supplierOrgMemberCanAccessQuote(quote) ||
        quoteBelongsToCustomer(quote) ||
        requestDoc(quote.requestId).data.customerId == uid() ||
        contractorOrgCanReadSupplierQuote(quote);
    }

    match /supplierQuoteItems/{itemId} {
      allow read: if isSignedIn() && supplierQuoteItemReadAllowed(resource.data);
      allow create: if isSupplier() &&
        validLegacySupplierQuoteItem(request.resource.data) &&
        supplierQuoteDoc(request.resource.data.supplierQuoteId).data.supplierId == uid();
      allow update, delete: if false;
    }
  }
}
